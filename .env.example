POSTGRES_DB=ad_pipeline
POSTGRES_USER=ad_pipeline
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

MINIO_ROOT_USER=ad_pipeline
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=ad-pipeline
MINIO_INTERNAL_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# Общий секрет backend и отдельного ai_ad_ml для внутренних processing-ручек.
PROCESSING_SERVICE_TOKEN=change_this_processing_token

# --- Доменный вход через Keycloak -------------------------------------------
#
# Keycloak только продовый — IC-GROUP на https://ssoc.ic-group.ru. Копии для
# разработки нет, поэтому настоящий вход проверяется только на развёрнутом
# сервисе, а до тех пор работает вход по логину и паролю.
#
# Переключает всё одна настройка — AUTH_USE_KEYCLOAK в конце этого блока.
#
# Что нужно получить у администраторов SSO:
#   1. client_id отдельного клиента под это приложение (не CV);
#   2. client secret к нему;
#   3. прописанный на их стороне Redirect URI — значение AUTH_REDIRECT_URI ниже;
#   4. имя claim'а с группами AD и точные названия групп для админов.
#
# Путь realm зависит от версии Keycloak: /realms/IC-GROUP на 17+ и
# /auth/realms/IC-GROUP на 16 и старше. Проверяется запросом
# .well-known/openid-configuration по этому адресу.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Куда Keycloak возвращает браузер. Заменить localhost на адрес сервиса при
# развёртывании — и тот же адрес прописать в клиенте на стороне Keycloak.
AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Куда отправить человека после входа и после выхода — страница интерфейса.
AUTH_FRONTEND_URL=http://localhost:5173

# Группы, дающие права администратора: полный путь, как его отдаёт Keycloak,
# через запятую. Белый список — всё, что не перечислено, прав не даёт.
# Настоящие названия будут известны после первого входа на развёрнутом сервисе.
AUTH_ADMIN_GROUPS=

# Временная запись claim'ов входящих токенов — чтобы увидеть, что реально
# приезжает из IC-GROUP, и заполнить AUTH_ADMIN_GROUPS. Пишется декодированный
# payload, никогда сам токен. Внутри ФИО, логины и оргструктура: файл под
# .gitignore и в общий лог не уезжает. Включать так:
#   AUTH_CLAIMS_DUMP_PATH=.runtime/auth-claims.jsonl
AUTH_CLAIMS_DUMP_PATH=

# Способ входа. true — доменный вход через корпоративный Keycloak (тогда три
# значения выше обязаны быть заполнены, иначе backend не запустится).
# false — вход по логину и паролю: admin/admin с правами, user/user без них.
#
# Keycloak в компании только продовый, копии для разработки нет, — поэтому до
# развёртывания сервиса работает false. При развёртывании: заполнить реквизиты
# выше и поставить true.
AUTH_USE_KEYCLOAK=false
